{
  "expo": {
    "name": "Forma Fit",
    "slug": "forma",
    "scheme": [
      "forma",
      "com.googleusercontent.apps.75583717433-ukh9snjjdcq2mm8bls4sro3e1p5gs6h1",
      "com.googleusercontent.apps.75583717433-6t43iurn6akcuppfuffjob50ofup3r5k"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.formastudio.formafit",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.formastudio.formafit",
      "permissions": ["com.android.vending.BILLING"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "content", "mimeType": "application/x-fitdata" },
            { "scheme": "file",    "mimeType": "application/x-fitdata" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "content", "mimeType": "*/*", "pathPattern": ".*\\.fitdata" },
            { "scheme": "file",    "mimeType": "*/*", "pathPattern": ".*\\.fitdata" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "c506f610-80c2-4765-944b-365549fe283a"
      }
    },
    "owner": "lucasvulkans-organization"
  }
}
